# --- Django backend ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Leave POSTGRES_DB unset to fall back to sqlite for local dev.
POSTGRES_DB=smart_navbat
POSTGRES_USER=smart_navbat
POSTGRES_PASSWORD=smart_navbat
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Shared secret between the Django backend and the FastAPI bot_service.
INTERNAL_API_TOKEN=dev-internal-token

# --- bot_service ---
DJANGO_API_BASE_URL=http://backend:8000/api
